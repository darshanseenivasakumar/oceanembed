{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phase1-app",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app/streamlit_app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8501,
      "env": {
        "PYTHONPATH": "src"
      }
