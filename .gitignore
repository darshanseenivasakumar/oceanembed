# --- Data & large files (NEVER commit these) ---
# NOTE: leading slash = repo root ONLY. A bare `data/` would also match src/oceanembed/data/
# (our source module) and silently drop it from the repo. Keep these anchored.
/data/
*.nc
*.zarr/
*.grib

# Research papers stay local, never in the repo
/all research papers/

# --- Model artifacts: ignore everything EXCEPT the tiny fixtures ---
/artifacts/*
!/artifacts/sample_X.npy
!/artifacts/sample_y.npy
!/artifacts/sample_meta.parquet
!/artifacts/sample_meta.csv
*.pt
*.pkl
*.ckpt

# --- Secrets / credentials (NEVER commit) ---
.env
.env.*
*.key
*_token*
credentials*
.copernicusmarine/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local memory (keep private) ---
.remember/

# shared data bundle (built by hand, never committed)
oceanembed_phase2_data.zip
PHASE2_DATA_MANIFEST.json

# build metadata from pip install -e .
src/*.egg-info/
